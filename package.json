{
  "name": "oh-my-pi-chat-extend",
  "displayName": "GramHoang OMP Chat Extend",
  "description": "Copilot/Cursor-style chat sidebar for OMP (omp) in VS Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chakyiu/omp-vscode"
  },
  "version": "0.8.0",
  "publisher": "gramphoang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "ai",
    "chat",
    "coding-agent"
  ],
  "activationEvents": [
    "onView:ompChatExtend.sidebar",
    "onCommand:ompChatExtend.open",
    "onCommand:ompChatExtend.newChat",
    "onCommand:ompChatExtend.sendSelection",
    "onCommand:ompChatExtend.attachFiles",
    "onCommand:ompChatExtend.attachFolder",
    "onCommand:ompChatExtend.attachMenu",
    "onCommand:ompChatExtend.attachExplorer",
    "onCommand:ompChatExtend.attachTerminal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ompChatExtend",
          "title": "OMP Extend",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ompChatExtend": [
        {
          "type": "webview",
          "id": "ompChatExtend.sidebar",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ompChatExtend.open",
        "title": "OMP Extend: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ompChatExtend.newChat",
        "title": "OMP Extend: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "ompChatExtend.stop",
        "title": "OMP Extend: Stop Generation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ompChatExtend.sendSelection",
        "title": "OMP Extend: Send Selection to Chat"
      },
      {
        "command": "ompChatExtend.attachCurrentFile",
        "title": "OMP Extend: Attach Current File"
      },
      {
        "command": "ompChatExtend.restartSession",
        "title": "OMP Extend: Restart Session"
      },
      {
        "command": "ompChatExtend.attachFiles",
        "title": "OMP Extend: Attach Files",
        "icon": "$(attach)"
      },
      {
        "command": "ompChatExtend.attachFolder",
        "title": "OMP Extend: Attach Folder",
        "icon": "$(folder)"
      },
      {
        "command": "ompChatExtend.attachMenu",
        "title": "OMP Extend: Attach…",
        "icon": "$(attach)"
      },
      {
        "command": "ompChatExtend.attachExplorer",
        "title": "OMP Extend: Attach to Chat",
        "icon": "$(attach)"
      },
      {
        "command": "ompChatExtend.attachTerminal",
        "title": "OMP Extend: Attach Terminal Output",
        "icon": "$(terminal)"
      },
      {
        "command": "ompChatExtend.showToolLog",
        "title": "OMP Extend: Show File Touch Log",
        "icon": "$(output)"
      },
      {
        "command": "ompChatExtend.showErrorLog",
        "title": "OMP Extend: Show Error Log",
        "icon": "$(output)"
      },
      {
        "command": "ompChatExtend.toggleCollapseAll",
        "title": "OMP Extend: Toggle Expand/Collapse Details"
      },
      {
        "command": "ompChatExtend.toggleThinkingVisibility",
        "title": "OMP Extend: Toggle Thinking Blocks Visibility"
      },
      {
        "command": "ompChatExtend.toggleTerminalVisibility",
        "title": "OMP Extend: Toggle Terminal / Tool Run Blocks Visibility"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ompChatExtend.newChat",
          "when": "view == ompChatExtend.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "ompChatExtend.stop",
          "when": "view == ompChatExtend.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "ompChatExtend.restartSession",
          "when": "view == ompChatExtend.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "ompChatExtend.attachMenu",
          "when": "view == ompChatExtend.sidebar",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "ompChatExtend.sendSelection",
          "when": "editorHasSelection",
          "group": "ompChatExtend@1"
        },
        {
          "command": "ompChatExtend.attachCurrentFile",
          "group": "ompChatExtend@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ompChatExtend.attachExplorer",
          "group": "ompChatExtend@1"
        }
      ],
      "terminal/context": [
        {
          "command": "ompChatExtend.attachTerminal",
          "group": "ompChatExtend@1"
        }
      ]
    },
    "configuration": {
      "title": "OMP Chat",
      "properties": {
        "ompChatExtend.ompPath": {
          "type": "string",
          "default": "omp",
          "description": "Path to the omp executable."
        },
        "ompChatExtend.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override (fuzzy match, e.g. opus, gpt-5.2)."
        },
        "ompChatExtend.thinking": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "auto"
          ],
          "default": "",
          "description": "Optional thinking level passed to omp."
        },
        "ompChatExtend.approvalMode": {
          "type": "string",
          "enum": [
            "",
            "always-ask",
            "write",
            "yolo"
          ],
          "default": "",
          "description": "Optional tools.approvalMode override for this session."
        },
        "ompChatExtend.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Pass --auto-approve to omp (skip approval prompts)."
        },
        "ompChatExtend.continueLastSession": {
          "type": "boolean",
          "default": true,
          "description": "Restore all open omp chat tabs/sessions when the chat bridge starts (survives VS Code restarts/kills). Disable to always start a blank session."
        },
        "ompChatExtend.autoTitle": {
          "type": "boolean",
          "default": true,
          "description": "Let omp generate a short session title after the first message (uses the tiny/smol title model). Shows on chat tabs and in history. Changing this offers a restart so open chats pick it up."
        },
        "ompChatExtend.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI args appended when spawning omp --mode rpc."
        },
        "ompChatExtend.mode": {
          "type": "string",
          "enum": [
            "Agent",
            "Ask",
            "Plan"
          ],
          "default": "Agent",
          "description": "Chat mode shown in the Cursor-style composer."
        },
        "ompChatExtend.displayName": {
          "type": "string",
          "default": "",
          "description": "Optional name used in the greeting (e.g. How can I help you, Alex?)."
        },
        "ompChatExtend.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show model thinking blocks in the chat UI."
        },
        "ompChatExtend.showTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show terminal run blocks in the chat UI."
        },
        "ompChatExtend.showTools": {
          "type": "boolean",
          "default": true,
          "description": "Show tool activity blocks (Grep, Read, Edit, Write, Bash) in the chat UI."
        },
        "ompChatExtend.logFileTouches": {
          "type": "boolean",
          "default": true,
          "description": "Log edit/write/delete tool calls and touched file paths to the \"OMP File Touches\" output channel."
        }
      }
    },
    "keybindings": [
      {
        "command": "ompChatExtend.open",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "ompChatExtend.sendSelection",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "package:dev": "node scripts/package-dev.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
